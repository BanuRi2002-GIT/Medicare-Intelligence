
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// USER MANAGEMENT
// ==========================================

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles                UserRole[]
  patient                  Patient?
  doctor                   Doctor?
  uploadedMedicalDocuments MedicalDocument[]
  auditLogs                AuditLog[]
  notifications            Notification[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================
// PATIENT MANAGEMENT
// ==========================================

model Patient {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?   @db.VarChar(20)
  address          String?   @db.Text
  emergencyContact String?   @map("emergency_contact") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  medicalDocuments MedicalDocument[]

  // Patient health information
  allergies        PatientAllergy[]
  conditions       PatientCondition[]

  @@map("patients")
}

// ==========================================
// PATIENT ALLERGY MANAGEMENT
// ==========================================

model PatientAllergy {
  id        Int      @id @default(autoincrement())
  patientId Int      @map("patient_id")
  allergen  String   @db.VarChar(191)
  reaction  String?  @db.VarChar(500)
  severity  String?  @db.VarChar(30)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_allergies")
}

// ==========================================
// PATIENT MEDICAL CONDITION MANAGEMENT
// ==========================================

model PatientCondition {
  id            Int       @id @default(autoincrement())
  patientId     Int       @map("patient_id")
  conditionName String    @map("condition_name") @db.VarChar(191)
  description   String?   @db.Text
  diagnosedAt   DateTime? @map("diagnosed_at")
  status        String    @default("ACTIVE") @db.VarChar(30)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_conditions")
}

// ==========================================
// DEPARTMENT MANAGEMENT
// ==========================================

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  doctors Doctor[]

  @@map("departments")
}

// ==========================================
// DOCTOR MANAGEMENT
// ==========================================

model Doctor {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  departmentId    Int      @map("department_id")
  licenseNumber   String   @unique @map("license_number") @db.VarChar(100)
  specialization  String   @db.VarChar(150)
  qualifications  String?  @db.Text
  experienceYears Int      @default(0) @map("experience_years")
  consultationFee Decimal  @map("consultation_fee") @db.Decimal(10, 2)
  currencyCode    String   @default("LKR") @map("currency_code") @db.VarChar(3)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  department     Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  schedules      DoctorSchedule[]
  leaves         DoctorLeave[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]

  @@index([departmentId])
  @@map("doctors")
}

// ==========================================
// DOCTOR SCHEDULE MANAGEMENT
// ==========================================

model DoctorSchedule {
  id          Int      @id @default(autoincrement())
  doctorId    Int      @map("doctor_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

// ==========================================
// DOCTOR LEAVE MANAGEMENT
// ==========================================

model DoctorLeave {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctor_id")
  leaveDate DateTime @map("leave_date") @db.Date
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([doctorId, leaveDate])
  @@index([leaveDate])
  @@map("doctor_leaves")
}

// ==========================================
// APPOINTMENT MANAGEMENT
// ==========================================

model Appointment {
  id        Int               @id @default(autoincrement())
  patientId Int               @map("patient_id")
  doctorId  Int               @map("doctor_id")
  startAt   DateTime          @map("start_at")
  endAt     DateTime          @map("end_at")
  status    AppointmentStatus @default(PENDING)
  reason    String?           @db.Text
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord?

  @@index([patientId, startAt])
  @@index([doctorId, startAt, endAt])
  @@map("appointments")
}

// ==========================================
// MEDICAL RECORD MANAGEMENT
// ==========================================

model MedicalRecord {
  id            Int               @id @default(autoincrement())
  patientId     Int               @map("patient_id")
  doctorId      Int               @map("doctor_id")
  appointmentId Int?              @unique @map("appointment_id")
  recordType    MedicalRecordType @default(CONSULTATION) @map("record_type")
  title         String            @db.VarChar(200)
  description   String?           @db.Text
  clinicalNotes String?           @map("clinical_notes") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  diagnoses     Diagnosis[]
  prescriptions Prescription[]

  @@index([patientId, createdAt])
  @@index([doctorId])
  @@map("medical_records")
}

// ==========================================
// DIAGNOSIS MANAGEMENT
// ==========================================

model Diagnosis {
  id              Int      @id @default(autoincrement())
  medicalRecordId Int      @map("medical_record_id")
  diagnosisName   String   @map("diagnosis_name") @db.VarChar(200)
  description     String?  @db.Text
  diagnosedAt     DateTime @default(now()) @map("diagnosed_at")

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)

  @@index([medicalRecordId])
  @@map("diagnoses")
}

// ==========================================
// PRESCRIPTION MANAGEMENT
// ==========================================

model Prescription {
  id              Int      @id @default(autoincrement())
  medicalRecordId Int      @map("medical_record_id")
  doctorId        Int      @map("doctor_id")
  patientId       Int      @map("patient_id")
  instructions    String?  @db.Text
  issuedAt        DateTime @default(now()) @map("issued_at")

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items         PrescriptionItem[]

  @@index([patientId, issuedAt])
  @@map("prescriptions")
}

// ==========================================
// PRESCRIPTION ITEM MANAGEMENT
// ==========================================

model PrescriptionItem {
  id             Int      @id @default(autoincrement())
  prescriptionId Int      @map("prescription_id")
  medicationName String   @map("medication_name") @db.VarChar(200)
  dosage         String   @db.VarChar(100)
  frequency      String   @db.VarChar(100)
  duration       String   @db.VarChar(100)
  instructions   String?  @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ==========================================
// MEDICAL DOCUMENT MANAGEMENT
// ==========================================

model MedicalDocument {
  id               Int                 @id @default(autoincrement())
  patientId        Int                 @map("patient_id")
  uploadedByUserId Int                 @map("uploaded_by_user_id")
  documentType     MedicalDocumentType @map("document_type")
  title            String              @db.VarChar(200)
  originalName     String              @map("original_name") @db.VarChar(255)
  storedName       String              @unique @map("stored_name") @db.VarChar(255)
  mimeType         String              @map("mime_type") @db.VarChar(100)
  fileSize         Int                 @map("file_size")
  createdAt        DateTime            @default(now()) @map("created_at")

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedBy User    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([uploadedByUserId])
  @@map("medical_documents")
}

// ==========================================
// AUDIT LOG MANAGEMENT
// ==========================================

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int?        @map("user_id")
  action      AuditAction
  entity      String      @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.VarChar(100)
  description String?     @db.Text
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ==========================================
// NOTIFICATION MANAGEMENT
// ==========================================

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String           @db.VarChar(200)
  message   String           @db.Text
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
  HEALTHCARE_STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum MedicalRecordType {
  CONSULTATION
  DIAGNOSIS
  LAB_REPORT
  PRESCRIPTION
  OTHER
}

enum MedicalDocumentType {
  LAB_REPORT
  SCAN_REPORT
  PRESCRIPTION
  REFERRAL_LETTER
  DISCHARGE_SUMMARY
  OTHER
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  READ
  UPDATE
  DELETE
  DOWNLOAD
  ACCESS_DENIED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  APPOINTMENT_REJECTED
  GENERAL
}
